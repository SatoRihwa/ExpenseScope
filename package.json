{
  "name": "expensescope-demo",
  "version": "0.1.0",
  "private": true,
  "description": "ExpenseScope Demo - 個人向け支出管理アプリ (Devin Review / Devin Security ウェビナー用デモ)",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx --env-file-if-exists=.env.local scripts/db-init.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
