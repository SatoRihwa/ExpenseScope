# コピーして .env.local を作成してください: cp .env.example .env.local
# .env.local は Git 管理対象外です。以下はダミー値です。実運用の秘密情報は入れないでください。

# 検証用ユーザーのパスワード (db:seed 実行時にハッシュ化して DB に保存されます)
DEMO_USER_A_PASSWORD=change-me-user-a
DEMO_USER_B_PASSWORD=change-me-user-b

# SQLite ファイルの場所 (省略時: data/expensescope.db)
DATABASE_PATH=data/expensescope.db

# デモ用に「今日」を固定する日付 (YYYY-MM-DD)。空にすると実際の今日 (APP_TIMEZONE 基準) を使います。
APP_TODAY=2026-11-10
APP_TIMEZONE=Asia/Tokyo

# HTTPS で配信する場合のみ true (Cookie に Secure 属性を付与)
COOKIE_SECURE=false
